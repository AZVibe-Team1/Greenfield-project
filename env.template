# Essential Environment Variables for Job Portal
# Copy this file to .env and fill in your actual values

# Database - MongoDB Connection
# Replace with your values from slack
MONGO_DB_USER=MS_db_user
MONGO_DB_PASSWORD=4H2XTp1B3wZcWFGv
MONGO_DB_URL=mongodb+srv://${MONGO_DB_USER}:${MONGO_DB_PASSWORD}@job-portal.rwdy5sh.mongodb.net/?appName=job-portal
MONGO_DB_NAME='job-portal'
