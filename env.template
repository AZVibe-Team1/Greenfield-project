MONGO_EMPLOYER_NAME='employer'
#mongodb+srv://<db_username>:<db_password>@job-portal.rwdy5sh.mongodb.net/?appName=job-portal

# ChromaDB Configuration
CHROMA_PC_PATH=./chroma_db
ALLOW_ORIGINS=http://localhost:3000

# AWS Credentials (if we use bedrock)
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_REGION=us-east-1
AWS_SESSION_TOKEN=
# Non permament (12hours)
AWS_BEARER_TOKEN_BEDROCK=""
BEDROCK_MODEL=amazon.nova-lite-v1:0

# OPENAI (if we use chatgpt models)
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o-mini

# Langsmith (if we use langsmith)
LANGSMITH_API_KEY=
LANGSMITH_TRACING="true"
LANGSMITH_ENDPOINT="https://api.smith.langchain.com"
LANGSMITH_PROJECT="job_portal"

# n8n Configuration (for workflow automation and email notifications)
# Docker: Use http://n8n:5678 for internal communication
# Local: Use http://localhost:5678 for local development
N8N_API_URL=http://n8n:5678
# Webhook URL will be available after creating the workflow in n8n UI
# N8N_WEBHOOK_URL=http://n8n:5678/webhook/interview-schedule
# For testing
N8N_WEBHOOK_URL=http://n8n:5678/webhook-test/webhook/interview-schedule
# Optional: API key for n8n authentication (if enabled)
N8N_API_KEY=

# CORS - Frontend URL
CORS_ORIGINS=http://localhost:3000
FRONTEND_URL=http://localhost:3000

# Next.js
# Local Machine
# NEXT_PUBLIC_BACKEND_URL=http://localhost:8000
# Docker
NEXT_PUBLIC_BACKEND_URL=http://backend:8000

