# Production Frontend Dockerfile for WorkAtlas (Next.js 14)
# This Dockerfile builds and serves the Next.js application in production mode

# Use Node.js 20 LTS as base image
FROM node:20-slim

# Set working directory inside the container
WORKDIR /app

# Set environment variables (NODE_ENV will be set to production later for runtime)
ENV NEXT_TELEMETRY_DISABLED=1

# Install system dependencies
RUN apt-get update && apt-get install -y \
    curl \
    && rm -rf /var/lib/apt/lists/*

# Copy package files first for better Docker layer caching
COPY package*.json ./

# Install all dependencies including devDependencies (needed for build)
# NODE_ENV is not set to production here so devDependencies are installed
RUN npm ci

# Copy the rest of the application code
COPY . .

# Build the Next.js application (this will use production optimizations)
RUN NODE_ENV=production npm run build

# Set NODE_ENV to production for runtime
ENV NODE_ENV=production

# Expose port 3000 - default Next.js port
EXPOSE 3000

# Start the Next.js production server
CMD ["npm", "start"]

